{
  "datasets": [
    {
      "name": "1b8a108b",
      "displayName": "Star schema",
      "queryLines": [
        "\n",
        "SELECT \n",
        "    date_trunc('month', date_key) AS mois,\n",
        "    ROUND(SUM(total_item_value), 2) AS chiffre_affaires\n",
        "FROM dbw_lab.gold.fact_order_items\n",
        "WHERE order_status = 'delivered'\n",
        "GROUP BY mois\n",
        "ORDER BY mois;"
      ],
      "catalog": "dbw_lab",
      "schema": "gold"
    },
    {
      "name": "8de15b67",
      "displayName": "kpis",
      "queryLines": [
        "SELECT \n",
        "    COUNT(DISTINCT order_id) AS total_commandes,\n",
        "    ROUND(SUM(total_item_value), 2) AS chiffre_affaires_total\n",
        "FROM dbw_lab.gold.fact_order_items\n",
        "WHERE order_status = 'delivered';"
      ]
    },
    {
      "name": "2e038377",
      "displayName": "categorie_rentables",
      "queryLines": [
        "SELECT \n",
        "    p.category_name AS categorie,\n",
        "    ROUND(SUM(f.total_item_value), 2) AS chiffre_affaires\n",
        "FROM dbw_lab.gold.fact_order_items f\n",
        "JOIN dbw_lab.gold.dim_products p ON f.product_id = p.product_id\n",
        "WHERE p.category_name IS NOT NULL AND f.order_status = 'delivered'\n",
        "GROUP BY p.category_name\n",
        "ORDER BY chiffre_affaires DESC\n",
        "LIMIT 10;"
      ]
    },
    {
      "name": "06a3c1d6",
      "displayName": "Top_5_Clients",
      "queryLines": [
        "SELECT \n",
        "    c.customer_unique_id AS id_client,\n",
        "    COUNT(DISTINCT f.order_id) AS nombre_commandes,\n",
        "    ROUND(SUM(f.total_item_value), 2) AS total_depense\n",
        "FROM dbw_lab.gold.fact_order_items f\n",
        "JOIN dbw_lab.gold.dim_customers c ON f.customer_id = c.customer_id\n",
        "WHERE f.order_status = 'delivered'\n",
        "GROUP BY c.customer_unique_id\n",
        "ORDER BY total_depense DESC\n",
        "LIMIT 5;"
      ]
    },
    {
      "name": "cc9f7bcd",
      "displayName": "statut_commandes",
      "queryLines": [
        "SELECT \n",
        "    order_status AS statut,\n",
        "    COUNT(DISTINCT order_id) AS nombre_commandes\n",
        "FROM dbw_lab.gold.fact_order_items\n",
        "GROUP BY order_status;"
      ]
    },
    {
      "name": "4eee235f",
      "displayName": "Ventes_par_Etat",
      "queryLines": [
        "SELECT \n",
        "    'BR' AS pays,\n",
        "    CONCAT('BR-', c.customer_state) AS etat_iso,\n",
        "    ROUND(SUM(f.total_item_value), 2) AS chiffre_affaires\n",
        "FROM dbw_lab.gold.fact_order_items f\n",
        "JOIN dbw_lab.gold.dim_customers c ON f.customer_id = c.customer_id\n",
        "WHERE f.order_status = 'delivered'\n",
        "GROUP BY c.customer_state;"
      ]
    },
    {
      "name": "1c97b188",
      "displayName": "commade_per_days",
      "queryLines": [
        "SELECT\n",
        "  CASE dayofweek(date_key)\n",
        "    WHEN 1 THEN 'Dimanche'\n",
        "    WHEN 2 THEN 'Lundi'\n",
        "    WHEN 3 THEN 'Mardi'\n",
        "    WHEN 4 THEN 'Mercredi'\n",
        "    WHEN 5 THEN 'Jeudi'\n",
        "    WHEN 6 THEN 'Vendredi'\n",
        "    WHEN 7 THEN 'Samedi'\n",
        "  END AS jour_semaine,\n",
        "  COUNT(DISTINCT order_id) AS nombre_commandes,\n",
        "  dayofweek(date_key) AS num_jour\n",
        "FROM\n",
        "  dbw_lab.gold.fact_order_items\n",
        "GROUP BY\n",
        "  CASE dayofweek(date_key)\n",
        "    WHEN 1 THEN 'Dimanche'\n",
        "    WHEN 2 THEN 'Lundi'\n",
        "    WHEN 3 THEN 'Mardi'\n",
        "    WHEN 4 THEN 'Mercredi'\n",
        "    WHEN 5 THEN 'Jeudi'\n",
        "    WHEN 6 THEN 'Vendredi'\n",
        "    WHEN 7 THEN 'Samedi'\n",
        "  END,\n",
        "  dayofweek(date_key)\n",
        "ORDER BY\n",
        "  num_jour;"
      ]
    },
    {
      "name": "ae4b12e1",
      "displayName": "top+vendeurs",
      "queryLines": [
        "SELECT\n",
        "  f.seller_id,\n",
        "  s.seller_city,\n",
        "  s.seller_state,\n",
        "  CONCAT(s.seller_city, ' (', s.seller_state, ')') AS vendeur,\n",
        "  ROUND(SUM(f.total_item_value), 2) AS chiffre_affaires_vendeur\n",
        "FROM\n",
        "  dbw_lab.gold.fact_order_items f\n",
        "    JOIN dbw_lab.gold.dim_sellers s\n",
        "      ON f.seller_id = s.seller_id\n",
        "WHERE\n",
        "  f.order_status = 'delivered'\n",
        "GROUP BY\n",
        "  f.seller_id,\n",
        "  s.seller_city,\n",
        "  s.seller_state\n",
        "ORDER BY\n",
        "  chiffre_affaires_vendeur DESC\n",
        "LIMIT 5;"
      ]
    }
  ],
